      einem kompletten Web-Dashboard. Alles konfigurierbar in wenigen Minuten.
    </p>

    <div class="g-cta">
      <a href="https://discord.com/oauth2/authorize?client_id=1503069687263526922&permissions=8&integration_type=0&scope=bot" target="_blank" class="g-btn g-btn-primary g-btn-lg">Hol dir pOky jetzt</a>
      <a href="/funktionen" class="g-arrow-link">Entdecke die Funktionen <span class="g-arrow">&rarr;</span></a>
    </div>

    <!-- Live Stats -->
    <div class="live-stats g-stats">
      <div class="live-stat">
        <span class="live-stat-num"><span id="stat-guilds" data-target="0">0</span></span>
        <span class="live-stat-label">Server</span>
      </div>
      <div class="live-stat">
        <span class="live-stat-num"><span id="stat-members" data-target="0">0</span></span>
        <span class="live-stat-label">Mitglieder</span>
      </div>
      <div class="live-stat">
