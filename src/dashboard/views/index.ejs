<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>pOky Dashboard</title>
  <link rel="stylesheet" href="/css/style.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
</head>
<body>
  <!-- Theme Switcher -->
  <div class="theme-switcher">
    <div class="theme-dot theme-dot-pink active" data-theme="pink" title="Pink Theme"></div>
    <div class="theme-dot theme-dot-dark" data-theme="dark" title="Dark Theme"></div>
    <div class="theme-dot theme-dot-orange" data-theme="orange" title="Orange Theme"></div>
  </div>
  <div class="hero">
    <canvas id="animated-bg"></canvas>
    <div class="floating-shapes">
      <div class="float-circle"></div>
      <div class="float-circle"></div>
      <div class="float-circle"></div>
      <div class="float-circle"></div>
      <div class="float-circle"></div>
      <div class="float-circle"></div>
      <div class="particle-dot"></div>
      <div class="particle-dot"></div>
      <div class="particle-dot"></div>
      <div class="particle-dot"></div>
      <div class="particle-dot"></div>
    </div>
    <nav class="navbar">
      <div class="logo">
        <svg class="logo-icon" width="34" height="34" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <ellipse cx="50" cy="54" rx="44" ry="42" fill="#f799b9"/>
          <ellipse cx="34" cy="46" rx="6" ry="12" fill="#2d1f2c"/>
          <ellipse cx="32" cy="42" rx="2.5" ry="5" fill="white"/>
          <ellipse cx="66" cy="46" rx="6" ry="12" fill="#2d1f2c"/>
          <ellipse cx="64" cy="42" rx="2.5" ry="5" fill="white"/>
          <path d="M42 61 Q50 67 58 61" stroke="#2d1f2c" stroke-width="2.5" fill="none" stroke-linecap="round"/>
          <ellipse cx="26" cy="57" rx="7" ry="5" fill="#e0739d" opacity="0.6"/>
          <ellipse cx="74" cy="57" rx="7" ry="5" fill="#e0739d" opacity="0.6"/>
          <ellipse cx="34" cy="92" rx="13" ry="7" fill="#e0739d"/>
          <ellipse cx="66" cy="92" rx="13" ry="7" fill="#e0739d"/>
        </svg>
        <span>pOky</span>
      </div>
      <div class="nav-links">
        <% if (user) { %>
          <a href="/dashboard" class="btn btn-secondary">Dashboard</a>
          <a href="/logout" class="btn btn-outline">Abmelden</a>
        <% } else { %>
          <a href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-accent">➕ Bot einladen</a>
          <a href="/login" class="btn btn-primary">🔐 Mit Discord anmelden</a>
        <% } %>
      </div>
    </nav>

    <div class="hero-content">
      <h1>Dein Discord pOky Bot</h1>
      <p class="subtitle">Moderation, Tickets, Willkommensnachrichten und mehr — alles im Griff mit dem Web Dashboard.</p>
      <div class="features">
        <div class="feature-card">
          <span class="feature-icon">🛡️</span>
          <h3>Moderation</h3>
          <p>Kick, Ban, Timeout, Warns und detaillierte Logs</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">🎫</span>
          <h3>Ticket System</h3>
          <p>Einfaches Support-Ticket-Management</p>
        </div>
        <div class="feature-card">
          <span class="feature-icon">📊</span>
          <h3>Dashboard</h3>
          <p>Alles im Blick: Stats, Logs und Einstellungen</p>
        </div>
      </div>
      <% if (!user) { %>
        <div class="hero-cta">
          <a href="/login" class="btn btn-large btn-primary">🚀 Jetzt anmelden</a>
          <a href="https://discord.com/oauth2/authorize?client_id=<%= clientId %>&permissions=8&scope=bot%20applications.commands" target="_blank" class="btn btn-large btn-accent">➕ Bot einladen</a>
        </div>
      <% } %>
    </div>
  </div>
  <script src="/js/animated-bg.js"></script>
  <script src="/js/theme.js"></script>
</body>
</html>
