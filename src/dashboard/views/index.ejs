            <circle cx="34" cy="44" r="7" fill="#111"/>
            <circle cx="66" cy="44" r="7" fill="#111"/>
            <circle cx="32" cy="42" r="2.5" fill="#fff"/>
            <circle cx="64" cy="42" r="2.5" fill="#fff"/>
            <ellipse cx="34" cy="86" rx="9" ry="5.5" fill="#FF8FAB"/>
            <ellipse cx="66" cy="86" rx="9" ry="5.5" fill="#FF8FAB"/>
          </svg>
