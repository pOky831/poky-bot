          </div>
          <div class="g-mock-card">
            <div class="g-mock-card-icon">🎫</div>
            <div class="g-mock-card-title">Tickets</div>
            <div class="g-mock-card-desc">Support &amp; Claims</div>
          </div>
          <div class="g-mock-card">
            <div class="g-mock-card-icon">📈</div>
            <div class="g-mock-card-title">Leveling</div>
            <div class="g-mock-card-desc">XP · Rollen · Ranks</div>
          </div>
          <div class="g-mock-card">
            <div class="g-mock-card-icon">⚠️</div>
            <div class="g-mock-card-title">Warnsystem</div>
            <div class="g-mock-card-desc">3-Strike &amp; Timeout</div>
          </div>
          <div class="g-mock-card">
