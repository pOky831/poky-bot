<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>pOky Bot — Dein Allround Discord Bot</title>
<meta name="description" content="Moderation, Tickets, Leveling & Giveaways — pOky ist der All-in-One Discord Bot für deine Community.">
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="landing-body">

<canvas id="bg"></canvas>
<div class="bg-glow"></div>

<div class="landing-container">
  <nav class="landing-nav">
    <div class="logo">
      <div class="logo-wrap">
        <svg class="logo-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="52" r="42" fill="#FFB7C5"/>
          <circle cx="34" cy="44" r="7" fill="#111"/>
          <circle cx="66" cy="44" r="7" fill="#111"/>
          <circle cx="32" cy="42" r="2.5" fill="#fff"/>
          <circle cx="64" cy="42" r="2.5" fill="#fff"/>
          <path d="M44 63 Q50 69 56 63" stroke="#111" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.35"/>
          <ellipse cx="34" cy="86" rx="9" ry="5.5" fill="#FF8FAB"/>
          <ellipse cx="66" cy="86" rx="9" ry="5.5" fill="#FF8FAB"/>
        </svg>
      </div>
      <span class="logo-text">pOky</span>
    </div>
    <div class="landing-nav-links">
      <% if (user) { %>
        <a href="/dashboard" class="btn btn-primary">Dashboard</a>
        <a href="/logout" class="btn btn-outline">Abmelden</a>
      <% } else { %>
        <a href="/login" class="btn btn-primary">Sign in</a>
      <% } %>
    </div>
  </nav>

  <!-- ═══════════ HERO ═══════════ -->
