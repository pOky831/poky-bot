<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= guild.name %> | NCRP</title>
<link rel="stylesheet" href="/css/style.css">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
</head>
<body class="dashboard-body">

<canvas id="bg"></canvas>

<aside class="sidebar">
  <div class="sidebar-head">
    <div class="logo-wrap">
      <svg class="logo-svg" viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
        <circle cx="50" cy="52" r="42" fill="#FFB7C5"/>
        <circle cx="34" cy="44" r="7" fill="#111"/>
        <circle cx="66" cy="44" r="7" fill="#111"/>
        <circle cx="32" cy="42" r="2.5" fill="#fff"/>
        <circle cx="64" cy="42" r="2.5" fill="#fff"/>
        <path d="M44 63 Q50 69 56 63" stroke="#111" stroke-width="2" fill="none" stroke-linecap="round" opacity="0.35"/>
        <ellipse cx="34" cy="86" rx="9" ry="5.5" fill="#FF8FAB"/>
        <ellipse cx="66" cy="86" rx="9" ry="5.5" fill="#FF8FAB"/>
      </svg>
    </div>
    <span class="logo-text">NCRP</span>
  </div>

  <div class="sidebar-user">
    <div style="position:relative">
      <% if (user.avatar) { %>
        <div class="u-avatar"><img src="https://cdn.discordapp.com/avatars/<%= user.id %>/<%= user.avatar %>.png?size=64" alt="Avatar" onerror="this.parentElement.textContent='<%= user.username.charAt(0).toUpperCase() %>'"></div>
      <% } else { %>
        <div class="u-avatar"><%= user.username.charAt(0).toUpperCase() %></div>
      <% } %>
      <div class="u-status"></div>
    </div>
    <div class="u-info">
      <div class="u-name"><%= user.username %></div>
      <div class="u-tag"><%= user.id %></div>
    </div>
  </div>

  <div class="sidebar-search">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
    <input class="sbar" placeholder="Tabs durchsuchen..." id="sidebar-search-input" oninput="filterTabs()">
  </div>

  <div class="sidebar-tabs" id="sidebar-tabs-list">
    <button class="tab-btn active" onclick="switchTab(0, this)">
      <span class="tab-icon">📊</span>
      <span class="tab-label">Übersicht</span>
    </button>
    <button class="tab-btn" onclick="switchTab(1, this)">
      <span class="tab-icon">📈</span>
      <span class="tab-label">Leveling</span>
    </button>
    <button class="tab-btn" onclick="switchTab(2, this)">
      <span class="tab-icon">🛡️</span>
      <span class="tab-label">Auto-Mod</span>
    </button>
    <button class="tab-btn" onclick="switchTab(3, this)">
      <span class="tab-icon">🎉</span>
      <span class="tab-label">Giveaways</span>
    </button>
    <button class="tab-btn" onclick="switchTab(4, this)">
      <span class="tab-icon">🎫</span>
      <span class="tab-label">Tickets</span>
    </button>
    <button class="tab-btn" onclick="switchTab(5, this)">
      <span class="tab-icon">📋</span>
      <span class="tab-label">Mod-Logs</span>
    </button>
    <button class="tab-btn" onclick="switchTab(6, this)">
      <span class="tab-icon">👥</span>
      <span class="tab-label">Mitglieder</span>
    </button>
  </div>

  <div class="sidebar-footer-links">
    <a href="/dashboard" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-secondary)'">← Zurück zur Übersicht</a>
    <a href="/logout" onmouseover="this.style.color='var(--text)'" onmouseout="this.style.color='var(--text-secondary)'">Abmelden</a>
  </div>
</aside>

<main class="main-content">
  <div class="dashboard-hero">
    <div class="hero-art">
      <% if (guild.icon) { %>
        <img src="<%= guild.icon %>" alt="<%= guild.name %>">
      <% } else { %>
        <%= guild.name.charAt(0).toUpperCase() %>
      <% } %>
    </div>
    <div class="hero-meta">
      <h1><%= guild.name %></h1>
      <p>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="width:12px;height:12px;opacity:0.4"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        <%= guild.memberCount ? guild.memberCount.toLocaleString() + ' Mitglieder' : 'Mitglieder unbekannt' %>
      </p>
    </div>
  </div>

  <div class="hero-nav" id="hero-nav">
    <button class="hero-nav-btn active" onclick="switchTab(0)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m3 9 9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>Übersicht</button>
    <button class="hero-nav-btn" onclick="switchTab(1)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>Leveling</button>
    <button class="hero-nav-btn" onclick="switchTab(2)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Auto-Mod</button>
    <button class="hero-nav-btn" onclick="switchTab(3)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>Giveaways</button>
    <button class="hero-nav-btn" onclick="switchTab(4)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9a3 3 0 0 1 0 6v2a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-2a3 3 0 0 1 0-6V7a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2Z"/><path d="M13 5v2"/><path d="M13 17v2"/><path d="M13 11v2"/></svg>Tickets</button>
    <button class="hero-nav-btn" onclick="switchTab(5)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/></svg>Mod-Logs</button>
    <button class="hero-nav-btn" onclick="switchTab(6)"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>Mitglieder</button>
  </div>

  <div class="content-area" id="content-area">
    <div class="content-inner" id="content-inner"></div>
  </div>
</main>

<!-- Warn Modal -->
<div class="modal-overlay" id="warn-modal-overlay" style="display:none">
  <div class="modal-content">
    <div class="modal-header">
      <h2>⚠️ Verwarnung erteilen</h2>
      <button class="modal-close" onclick="closeWarnModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p>Verwarne <strong id="warn-modal-user"></strong></p>
      <label class="modal-label" for="warn-reason">Grund</label>
      <textarea id="warn-reason" class="inp modal-textarea" placeholder="Grund für die Verwarnung eingeben..." rows="3"></textarea>
      <div class="warn-consequence-info" id="warn-consequence-info">
        <span class="warn-consequence-icon">📋</span>
        <span id="warn-consequence-text"></span>
      </div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeWarnModal()">Abbrechen</button>
      <button class="btn btn-sm btn-pink" id="warn-submit-btn" onclick="submitWarn()">Verwarnen</button>
    </div>
  </div>
</div>

<!-- Timeout Modal -->
<div class="modal-overlay" id="timeout-modal-overlay" style="display:none">
  <div class="modal-content">
    <div class="modal-header">
      <h2>⏱️ Timeout verhängen</h2>
      <button class="modal-close" onclick="closeTimeoutModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p>Timeout für <strong id="timeout-modal-user"></strong></p>
      <label class="modal-label" for="timeout-duration">Dauer</label>
      <div class="timeout-duration-grid">
        <button class="timeout-preset" data-minutes="1" onclick="selectTimeoutPreset(1, '1 Minute')">1 Min</button>
        <button class="timeout-preset" data-minutes="5" onclick="selectTimeoutPreset(5, '5 Minuten')">5 Min</button>
        <button class="timeout-preset" data-minutes="10" onclick="selectTimeoutPreset(10, '10 Minuten')">10 Min</button>
        <button class="timeout-preset" data-minutes="60" onclick="selectTimeoutPreset(60, '1 Stunde')">1 Std</button>
        <button class="timeout-preset" data-minutes="1440" onclick="selectTimeoutPreset(1440, '1 Tag')">1 Tag</button>
        <button class="timeout-preset" data-minutes="10080" onclick="selectTimeoutPreset(10080, '1 Woche')">1 Wo</button>
        <button class="timeout-preset" data-minutes="20160" onclick="selectTimeoutPreset(20160, '2 Wochen')">2 Wo</button>
        <button class="timeout-preset" data-minutes="43200" onclick="selectTimeoutPreset(43200, '1 Monat')">1 Mon</button>
      </div>
      <input type="hidden" id="timeout-duration" value="">
      <div class="selected-timeout" id="selected-timeout" style="display:none">
        <span>⏱️</span> <span id="selected-timeout-text"></span>
      </div>
      <label class="modal-label" for="timeout-reason" style="margin-top:16px">Grund</label>
      <textarea id="timeout-reason" class="inp modal-textarea" placeholder="Grund für den Timeout..." rows="3"></textarea>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeTimeoutModal()">Abbrechen</button>
      <button class="btn btn-sm btn-pink btn-timeout-btn" id="timeout-submit-btn" onclick="submitTimeout()">Timeout verhängen</button>
    </div>
  </div>
</div>

<!-- Note Modal -->
<div class="modal-overlay" id="note-modal-overlay" style="display:none">
  <div class="modal-content">
    <div class="modal-header">
      <h2>📝 Notiz hinzufügen</h2>
      <button class="modal-close" onclick="closeNoteModal()">&times;</button>
    </div>
    <div class="modal-body">
      <p>Notiz für <strong id="note-modal-user"></strong></p>
      <label class="modal-label" for="note-text">Notiz</label>
      <textarea id="note-text" class="inp modal-textarea" placeholder="Notiz eingeben..." rows="4"></textarea>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeNoteModal()">Abbrechen</button>
      <button class="btn btn-sm btn-pink btn-note-btn" id="note-submit-btn" onclick="submitNote()">Notiz speichern</button>
    </div>
  </div>
</div>

<!-- Ticket History Modal -->
<div class="modal-overlay" id="ticket-modal-overlay" style="display:none">
  <div class="modal-content ticket-modal-content">
    <div class="modal-header">
      <div>
        <h2>🎫 Ticket-Verlauf</h2>
        <p style="font-size:12px;color:var(--text-secondary);margin-top:4px" id="ticket-modal-info"></p>
      </div>
      <button class="modal-close" onclick="closeTicketModal()">&times;</button>
    </div>
    <div class="ticket-modal-body" id="ticket-modal-body">
      <div class="ticket-modal-loading"><div class="spinner"></div><p>Lade Nachrichten...</p></div>
    </div>
    <div class="modal-footer">
      <button class="btn btn-secondary" onclick="closeTicketModal()">Schließen</button>
    </div>
  </div>
</div>

<script src="/js/animated-bg.js"></script>
<script>
var guildId = '<%= guild.id %>';

var activeTab = -1;
var tabTimeout = null;

function switchTab(i, sidebarBtn) {
  if (i === activeTab) return;

  // Update sidebar tabs
  document.querySelectorAll('.tab-btn').forEach(function(b, j) { b.classList.toggle('active', j === i); });
  // Update hero nav buttons
  document.querySelectorAll('.hero-nav-btn').forEach(function(b, j) { b.classList.toggle('active', j === i); });

  var inner = document.getElementById('content-inner');
  var v = getTabContent(i);

  // Clear any pending tab switch
  if (tabTimeout) clearTimeout(tabTimeout);

  // Fade out old content
  if (activeTab !== -1) {
    inner.style.opacity = '0';
    inner.style.transform = 'translateY(12px)';
  }

  tabTimeout = setTimeout(function() {
    inner.innerHTML = v;
    // Fade in new content
    requestAnimationFrame(function() {
      inner.style.opacity = '1';
      inner.style.transform = 'translateY(0)';
    });

    // Animate stat counters
    requestAnimationFrame(function() {
      document.querySelectorAll('.stat-counter').forEach(function(el) {
        var val = parseInt(el.getAttribute('data-val')) || 0;
        animateValue(el, 0, val, 1000);
      });
    });

    // Load members if tab 6
    if (i === 6 && allMembers.length === 0) { loadMembers(); }
    // Load ticket channels if tab 4
    if (i === 4) { loadTicketChannels(); loadSupportRolesList(); }

    tabTimeout = null;
  }, activeTab === -1 ? 0 : 180);

  activeTab = i;
}

function animateValue(el, start, end, duration) {
  if (!el) return;
  var range = end - start, startTime = performance.now();
  function tick(now) {
    var p = Math.min((now - startTime) / duration, 1);
    var ease = 1 - Math.pow(1 - p, 3);
    el.textContent = Math.floor(start + range * ease).toLocaleString();
    if (p < 1) requestAnimationFrame(tick);
    else el.textContent = end.toLocaleString();
  }
  requestAnimationFrame(tick);
}

function getTabContent(i) {
  // Tab content builders
  if (i === 0) return getOverviewTab();
  if (i === 1) return getLevelingTab();
  if (i === 2) return getAutomodTab();
  if (i === 3) return getGiveawaysTab();
  if (i === 4) return getTicketsTab();
  if (i === 5) return getModLogsTab();
  if (i === 6) return getMembersTab();
  return '<div class="empty">Coming soon</div>';
}

// ════════════════ TAB: Übersicht ════════════════
function getOverviewTab() {
  return '<div class="stats-bar stagger">' +
    '<div class="stat-item"><h3><span class="stat-counter" data-val="<%= stats.modCount %>">0</span></h3><p>Mod-Aktionen</p></div>' +
    '<div class="stat-item"><h3><span class="stat-counter" data-val="<%= stats.ticketCount %>">0</span></h3><p>Tickets gesamt</p></div>' +
    '<div class="stat-item"><h3><span class="stat-counter" data-val="<%= stats.openTicketCount %>">0</span></h3><p>Offene Tickets</p></div>' +
    '<div class="stat-item"><h3><span class="stat-counter" data-val="<%= leveling.levelRoles.length %>">0</span></h3><p>Level-Rollen</p></div>' +
  '</div>' +
  '<div class="grid-2 stagger">' +
    '<div class="card">' +
      '<div class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>Einstellungen</div>' +
      '<div class="row"><span class="rl">Willkommenskanal</span><span class="rv"><% var wc = settings?.welcome_channel_id; %><%= wc ? "<#" + wc + ">" : "Nicht gesetzt" %></span></div>' +
      '<div class="row"><span class="rl">Ticket-Kategorie</span><span class="rv"><%= settings?.ticket_category_id || "Nicht gesetzt" %></span></div>' +
      '<div class="row"><span class="rl">Mod-Rolle</span><span class="rv"><%= settings?.mod_role_id || "Nicht gesetzt" %></span></div>' +
      '<div class="row"><span class="rl">Level-Up Kanal</span><span class="rv"><% var lc = leveling.levelChannelId; %><%= lc ? "<#" + lc + ">" : "Nicht gesetzt" %></span></div>' +
    '</div>' +
    '<div class="card">' +
      '<div class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>Modul-Status</div>' +
      '<div class="row"><span class="rl"><span style="width:6px;height:6px;border-radius:50%;background:var(--green);display:inline-block"></span>Auto-Mod aktiv</span><span class="rv"><%= automod.enabled ? "An" : "Aus" %></span></div>' +
      '<div class="row"><span class="rl"><span style="width:6px;height:6px;border-radius:50%;background:<%= ticketPanel ? "var(--green)" : "var(--text-muted)" %>;display:inline-block"></span>Ticket-Panel</span><span class="rv"><%= ticketPanel ? "Gesetzt" : "Kein Panel" %></span></div>' +
      '<div class="row"><span class="rl"><span style="width:6px;height:6px;border-radius:50%;background:<%= leveling.levelChannelId ? "var(--green)" : "var(--text-muted)" %>;display:inline-block"></span>Leveling</span><span class="rv"><%= leveling.levelChannelId ? "Aktiv" : "Kein Kanal" %></span></div>' +
      '<div class="row"><span class="rl"><span style="width:6px;height:6px;border-radius:50%;background:var(--pink-light);display:inline-block"></span>Bad Words</span><span class="rv"><%= automod.words.length %> Wörter</span></div>' +
    '</div>' +
  '</div>';
}

// ════════════════ TAB: Leveling ════════════════
function getLevelingTab() {
  var rolesHtml = '';
  <% leveling.levelRoles.forEach(function(lr) { %>
    rolesHtml += '<span class="tag" data-level="<%= lr.level %>">⭐ Lv <%= lr.level %> → <@&<%= lr.role_id %>> <span class="tg-x" onclick="removeLevelRole(<%= lr.level %>)">&times;</span></span>';
  <% }); %>

  return '<div class="card">' +
    '<div class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>Leveling</div>' +
    '<div class="row">' +
      '<span><span class="rl">Level-Up Kanal</span><span class="rd">Benachrichtigungen</span></span>' +
      '<div style="display:flex;align-items:center;gap:6px"><input class="inp" id="level-channel" value="<%= leveling.levelChannelId || "" %>" placeholder="Channel ID" style="min-width:130px"><button class="btn btn-sm btn-save" onclick="saveLevelChannel()">💾</button></div>' +
    '</div>' +
    '<div style="padding:14px 0">' +
      '<div class="section"><h3>Level-Rollen</h3>' +
        '<div class="tag-list" id="level-roles-tags">' + rolesHtml + '</div>' +
        '<div style="display:flex;gap:8px;margin-top:12px;flex-wrap:wrap">' +
          '<input class="inp inp-n" id="level-role-level" placeholder="Lv">' +
          '<input class="inp" id="level-role-id" placeholder="Rollen-ID" style="min-width:130px">' +
          '<button class="btn btn-sm btn-pink" onclick="addLevelRole()">+</button>' +
          '<button class="btn btn-sm btn-secondary" onclick="clearLevelRoles()">Alle löschen</button>' +
        '</div>' +
      '</div>' +
    '</div>' +
  '</div>';
}

// ════════════════ TAB: Auto-Mod ════════════════
function getAutomodTab() {
  var wordsHtml = '';
  <% automod.words.forEach(function(w) { %>
    wordsHtml += '<span class="tag" data-word="<%= w %>"><%= w %> <span class="tg-x" onclick="removeAutomodWord(\'<%= w %>\')">&times;</span></span>';
  <% }); %>

  return '<div class="card">' +
    '<div class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>Auto-Mod</div>' +
    '<div class="row">' +
      '<span><span class="rl">Auto-Mod</span><span class="rd">Alle Filter</span></span>' +
      '<label class="toggle-switch"><input type="checkbox" id="automod-enabled" <%= automod.enabled ? "checked" : "" %> onchange="toggleAutomod(this)"><span class="toggle-slider"></span></label>' +
    '</div>' +
    '<div class="row">' +
      '<span><span class="rl">Anti-Spam</span><span class="rd">Max / 5s</span></span>' +
      '<div style="display:flex;align-items:center;gap:6px"><input class="inp inp-n" id="automod-spam" value="<%= automod.spamThreshold %>"><button class="btn btn-sm btn-save" onclick="saveAutomod(\'spam\')">💾</button></div>' +
    '</div>' +
    '<div class="row">' +
      '<span><span class="rl">Link-Filter</span></span>' +
      '<label class="toggle-switch"><input type="checkbox" id="automod-linkfilter" <%= automod.linkFilter ? "checked" : "" %> onchange="toggleLinkFilter(this)"><span class="toggle-slider"></span></label>' +
    '</div>' +
    '<div class="row">' +
      '<span><span class="rl">Mention-Cap</span></span>' +
      '<div style="display:flex;align-items:center;gap:6px"><input class="inp inp-n" id="automod-mentioncap" value="<%= automod.mentionCap %>"><button class="btn btn-sm btn-save" onclick="saveAutomod(\'mentioncap\')">💾</button></div>' +
    '</div>' +
    '<div style="padding:14px 0 0">' +
      '<h3 style="font-size:13px;font-weight:600;margin-bottom:12px;color:var(--text);display:flex;align-items:center;gap:6px">Bad Words</h3>' +
      '<div class="tag-list" id="words-tags">' + wordsHtml + '</div>' +
      '<div style="display:flex;gap:8px;margin-top:12px">' +
        '<input class="inp" id="automod-word-input" placeholder="Wort hinzufügen..." style="min-width:130px">' +
        '<button class="btn btn-sm btn-pink" onclick="addWord()">+</button>' +
        '<button class="btn btn-sm btn-secondary" onclick="clearWords()">Alle löschen</button>' +
      '</div>' +
    '</div>' +
  '</div>';
}

// ════════════════ TAB: Giveaways ════════════════
