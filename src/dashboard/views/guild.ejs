function joinMusicChannel() {
  // This is a UI convenience - the actual join happens on play
  var channelId = document.getElementById('music-channel-select').value;
  if (!channelId) { alert('Bitte wähle einen Voice-Channel aus.'); return; }
  // Just mark as selected, play will use it
  var btn = document.getElementById('music-join-btn');
  if (btn) { btn.textContent = '✅ Bereit'; btn.style.background = 'var(--green)'; }
  setTimeout(function() {
    if (btn) { btn.textContent = '▶️ Join'; btn.style.background = ''; }
  }, 2000);
}

function onMusicChannelChange() {
  var btn = document.getElementById('music-join-btn');
  if (btn) { btn.textContent = '▶️ Join'; btn.style.background = ''; }
}

function playMusic() {
  var query = (document.getElementById('music-search-input').value || '').trim();
  if (!query) { alert('Bitte gib einen Song-Namen oder YouTube-Link ein.'); return; }
  var channelId = document.getElementById('music-channel-select').value;
  if (!channelId) { alert('Bitte wähle einen Voice-Channel aus.'); return; }

  var btn = document.getElementById('music-play-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Suche...'; }

  fetch('/api/guild/' + guildId + '/music/play', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ query: query, voiceChannelId: channelId })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.error) { alert('❌ ' + data.error); return; }
    document.getElementById('music-search-input').value = '';
    refreshMusicStatus();
  }).catch(function(err) { alert('❌ Fehler: ' + err.message); })
  .finally(function() { if (btn) { btn.disabled = false; btn.textContent = '🔍 Spielen'; } });
}

function musicSkip() {
  fetch('/api/guild/' + guildId + '/music/skip', { method: 'POST' })
    .then(function(r) { return r.json(); }).then(function() { refreshMusicStatus(); });
}

function musicStop() {
  if (!confirm('Wiedergabe stoppen & Bot aus dem Voice-Channel entfernen?')) return;
  fetch('/api/guild/' + guildId + '/music/stop', { method: 'POST' })
    .then(function(r) { return r.json(); }).then(function() { refreshMusicStatus(); });
}

function musicPauseResume() {
  var pauseBtn = document.getElementById('music-pause-btn');
  var isPaused = pauseBtn && pauseBtn.textContent.trim() === '⏯️';
  // We determine from status, but for now just try both
  fetch('/api/guild/' + guildId + '/music/status')
    .then(function(r) { return r.json(); })
    .then(function(status) {
      var action = status.isPaused ? 'resume' : 'pause';
      fetch('/api/guild/' + guildId + '/music/' + action, { method: 'POST' })
        .then(function() { refreshMusicStatus(); });
    });
}

function setMusicVolume(val) {
  fetch('/api/guild/' + guildId + '/music/volume', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ volume: parseInt(val, 10) })
  }).then(function() {
    var display = document.getElementById('music-volume-value');
    if (display) display.textContent = val + '%';
  });
}

function onVolumeChange(val) {
  var display = document.getElementById('music-volume-value');
  if (display) display.textContent = val + '%';
}

function removeFromQueue(index) {
  fetch('/api/guild/' + guildId + '/music/queue/remove', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ index: index })
  }).then(function() { refreshMusicStatus(); });
}

function clearMusicQueue() {
  if (!confirm('Gesamte Warteschlange leeren?')) return;
  fetch('/api/guild/' + guildId + '/music/queue/clear', { method: 'POST' })
    .then(function() { refreshMusicStatus(); });
}

function refreshMusicStatus() {
  fetch('/api/guild/' + guildId + '/music/status')
    .then(function(r) { return r.json(); })
    .then(function(status) {
      renderNowPlaying(status);
      renderQueue(status.queue);
      updateMusicControls(status);
    })
    .catch(function() {});
}

function startMusicPolling() {
  if (musicPollInterval) clearInterval(musicPollInterval);
  musicPollInterval = setInterval(function() {
    // Only poll if music tab is active
    if (activeTab === 8) refreshMusicStatus();
  }, 3000);
}

function renderNowPlaying(status) {
  var container = document.getElementById('music-nowplaying');
  var controls = document.getElementById('music-controls');
  if (!container) return;

  var track = status.currentTrack;
  if (!track) {
    container.innerHTML = '<div class="music-np-placeholder"><span class="music-np-icon">🎶</span><p>Kein Song aktiv. Suche einen Song und klicke auf Spielen!</p></div>';
    if (controls) controls.style.display = 'none';
    return;
  }

  if (controls) controls.style.display = '';

  var stateLabel = status.isPaused ? '⏸️ Pausiert' : '▶️ Spielt';
  if (!status.isPlaying && !status.isPaused) stateLabel = '⏹️ Gestoppt';

  container.innerHTML =
    '<div class="music-np-track">' +
      (track.thumbnail ? '<img class="music-np-thumb" src="' + escapeHtml(track.thumbnail) + '" alt="" onerror="this.style.display=\'none\'">' : '') +
      '<div class="music-np-info">' +
        '<a class="music-np-title" href="' + escapeHtml(track.url) + '" target="_blank">' + escapeHtml(track.title) + '</a>' +
        '<span class="music-np-meta">' + escapeHtml(track.duration) + ' · ' + stateLabel + ' · von ' + escapeHtml(track.requestedByTag) + '</span>' +
      '</div>' +
    '</div>';

  var volSlider = document.getElementById('music-volume-slider');
  var volDisplay = document.getElementById('music-volume-value');
  if (volSlider) volSlider.value = status.volume;
  if (volDisplay) volDisplay.textContent = status.volume + '%';

  var pauseBtn = document.getElementById('music-pause-btn');
  if (pauseBtn) pauseBtn.textContent = status.isPaused ? '▶️' : '⏸️';
}

function renderQueue(queue) {
  var container = document.getElementById('music-queue-list');
  if (!container) return;

  if (!queue || queue.length === 0) {
    container.innerHTML = '<div class="music-queue-empty">Die Warteschlange ist leer.</div>';
    return;
  }

  var html = '';
  queue.forEach(function(track, i) {
    html += '<div class="music-queue-item">' +
      '<span class="music-queue-index">' + (i + 1) + '</span>' +
      '<div class="music-queue-info">' +
        '<a class="music-queue-title" href="' + escapeHtml(track.url) + '" target="_blank">' + escapeHtml(track.title) + '</a>' +
        '<span class="music-queue-meta">' + escapeHtml(track.duration) + ' · ' + escapeHtml(track.requestedByTag) + '</span>' +
      '</div>' +
      '<button class="btn btn-sm btn-danger music-queue-remove" onclick="removeFromQueue(' + i + ')" title="Entfernen">✕</button>' +
    '</div>';
  });
  container.innerHTML = html;
}

function updateMusicControls(status) {
  var voiceName = status.voiceChannelName;
  var sel = document.getElementById('music-channel-select');
  // If bot is in a VC, show that
  if (voiceName && sel) {
    for (var i = 0; i < sel.options.length; i++) {
      if (sel.options[i].text.indexOf(voiceName) !== -1) {
        sel.value = sel.options[i].value;
        break;
      }
    }
  }
}

// ══════════════════════════════════════════════

// Sidebar Tab Search Filter
function filterTabs() {
  var query = (document.getElementById('sidebar-search-input').value || '').toLowerCase();
  var tabs = document.querySelectorAll('#sidebar-tabs-list .tab-btn');
  tabs.forEach(function(tab) {
    var label = (tab.querySelector('.tab-label')?.textContent || '').toLowerCase();
    tab.style.display = label.indexOf(query) !== -1 ? '' : 'none';
  });
}
</script>
</body>
</html>
