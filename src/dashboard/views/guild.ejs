function sendEmbedMessage() {
  var channelId = document.getElementById('msg-channel-select').value;
  if (!channelId) { alert('Bitte wähle einen Kanal.'); return; }
  var title = (document.getElementById('msg-title').value || '').trim();
  var description = (document.getElementById('msg-description').value || '').trim();
  if (!title && !description) { alert('Bitte gib mindestens Titel oder Beschreibung an.'); return; }
  var color = (document.getElementById('msg-color').value || '#FF5E8A');
  var imageUrl = (document.getElementById('msg-image').value || '').trim();
  var footerText = (document.getElementById('msg-footer').value || '').trim();

  var btn = document.getElementById('msg-send-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Sende...'; }

  fetch('/api/guild/' + guildId + '/messages/send', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId: channelId, title: title, description: description, color: color, imageUrl: imageUrl, footerText: footerText })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) alert('✅ Nachricht wurde gesendet!');
    else alert('❌ Fehler: ' + (data.error || 'Unbekannt'));
  }).catch(function(err) { alert('❌ Fehler: ' + err.message); })
  .finally(function() { if (btn) { btn.disabled = false; btn.textContent = '📨 Senden'; } });
}

function previewEmbed() {
  var preview = document.getElementById('msg-preview');
  var title = (document.getElementById('msg-title').value || '').trim();
  var description = (document.getElementById('msg-description').value || '').trim();
  var color = document.getElementById('msg-color').value || '#FF5E8A';
  var imageUrl = (document.getElementById('msg-image').value || '').trim();
  var footerText = (document.getElementById('msg-footer').value || '').trim();

  preview.style.display = 'block';
  var html = '<div style="background: var(--bg-raised); border-left: 4px solid ' + color + '; border-radius: 0 8px 8px 0; padding: 20px 24px; max-width: 440px">';
  if (title) html += '<div style="font-size:16px;font-weight:700;margin-bottom:10px;color:#fff">' + escapeHtml(title) + '</div>';
  if (description) html += '<div style="font-size:14px;color:var(--text-secondary);line-height:1.6;white-space:pre-wrap">' + escapeHtml(description) + '</div>';
  if (imageUrl) html += '<img src="' + escapeHtml(imageUrl) + '" style="max-width:100%;border-radius:6px;margin-top:12px" onerror="this.style.display=\'none\'">';
  if (footerText) html += '<div style="font-size:11px;color:var(--text-muted);margin-top:14px;padding-top:12px;border-top:1px solid var(--border)">' + escapeHtml(footerText) + '</div>';
  html += '</div>';
  preview.innerHTML = html;
}

function hexToRgba(hex, alpha) {
  hex = hex.replace('#', '');
  if (hex.length === 3) hex = hex[0] + hex[0] + hex[1] + hex[1] + hex[2] + hex[2];
  var r = parseInt(hex.substring(0, 2), 16);
  var g = parseInt(hex.substring(2, 4), 16);
  var b = parseInt(hex.substring(4, 6), 16);
  return 'rgba(' + r + ',' + g + ',' + b + ',' + alpha + ')';
}

