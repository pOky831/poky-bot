// ══════════════════════════════════════════════
// Automod Functions
// ══════════════════════════════════════════════
function toggleAutomod(el) {
  fetch('/api/guild/' + guildId + '/automod/toggle', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ enabled: el.checked })
  });
}

function toggleLinkFilter(el) {
  fetch('/api/guild/' + guildId + '/automod/linkfilter', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ enabled: el.checked })
  });
}

function saveAutomod(type) {
  var inp = document.getElementById('automod-' + type);
  var val = parseInt(inp.value, 10);
  if (isNaN(val)) return;
  fetch('/api/guild/' + guildId + '/automod/' + type, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(type === 'mentioncap' ? { cap: val } : { threshold: val })
  }).then(function() {
    inp.style.borderColor = 'var(--green)';
    setTimeout(function() { inp.style.borderColor = ''; }, 1500);
  });
}

function addWord() {
  var input = document.getElementById('automod-word-input');
  var word = input.value.trim();
  if (!word) return;
  fetch('/api/guild/' + guildId + '/automod/words/add', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ word: word })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.setAttribute('data-word', word);
      tag.innerHTML = word + ' <span class="tg-x">&times;</span>';
      tag.querySelector('.tg-x').addEventListener('click', function() { removeAutomodWord(word); });
      document.getElementById('words-tags').appendChild(tag);
      input.value = '';
    }
  });
}

function removeAutomodWord(word) {
  fetch('/api/guild/' + guildId + '/automod/words/remove', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ word: word })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      var tags = document.querySelectorAll('#words-tags .tag');
      tags.forEach(function(tag) {
        if (tag.getAttribute('data-word') === word) tag.remove();
      });
    }
  });
}

function clearWords() {
  if (!confirm('Wirklich alle Bad Words löschen?')) return;
  fetch('/api/guild/' + guildId + '/automod/words/clear', { method: 'POST' })
    .then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) document.getElementById('words-tags').innerHTML = '';
    });
}

// ══════════════════════════════════════════════
// Leveling Functions
// ══════════════════════════════════════════════
function saveLevelChannel() {
  var input = document.getElementById('level-channel');
  fetch('/api/guild/' + guildId + '/leveling/channel', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId: input.value.trim() })
  }).then(function() {
    input.style.borderColor = 'var(--green)';
    setTimeout(function() { input.style.borderColor = ''; }, 1500);
  });
}

function addLevelRole() {
  var levelInput = document.getElementById('level-role-level');
  var roleInput = document.getElementById('level-role-id');
  var level = parseInt(levelInput.value, 10);
  var roleId = roleInput.value.trim();
  if (!level || !roleId) return;
  fetch('/api/guild/' + guildId + '/leveling/role/add', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ level: level, roleId: roleId })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      var tags = document.getElementById('level-roles-tags');
      var tag = document.createElement('span');
      tag.className = 'tag';
      tag.setAttribute('data-level', level);
      tag.innerHTML = '⭐ Lv ' + level + ' → <@&' + roleId + '> <span class="tg-x">&times;</span>';
      tag.querySelector('.tg-x').addEventListener('click', function() { removeLevelRole(level); });
      tags.appendChild(tag);
      levelInput.value = '';
      roleInput.value = '';
    }
  });
}

function removeLevelRole(level) {
  fetch('/api/guild/' + guildId + '/leveling/role/remove', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ level: level })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) {
      var tags = document.querySelectorAll('#level-roles-tags .tag');
      tags.forEach(function(tag) {
        if (tag.getAttribute('data-level') === String(level)) tag.remove();
      });
    }
  });
}

function clearLevelRoles() {
  if (!confirm('Wirklich alle Level-Rollen löschen?')) return;
  fetch('/api/guild/' + guildId + '/leveling/role/clear', { method: 'POST' })
    .then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) document.getElementById('level-roles-tags').innerHTML = '';
    });
}

// ══════════════════════════════════════════════
// Members Functions
// ══════════════════════════════════════════════
var allMembers = [];
var selectedMemberId = null;
var noteDataMap = {};

function loadMembers() {
  var grid = document.getElementById('members-grid');
  var loading = document.getElementById('members-loading');
  var empty = document.getElementById('members-empty');
  grid.innerHTML = '';
  empty.style.display = 'none';
  loading.style.display = 'flex';

  fetch('/api/guild/' + guildId + '/members')
    .then(function(r) { return r.json(); })
    .then(function(data) {
      loading.style.display = 'none';
      if (data.error) {
        empty.querySelector('p').textContent = 'Fehler: ' + data.error;
        empty.style.display = 'block';
        return;
      }
      allMembers = data;
      renderMembers(data);
    })
    .catch(function() {
      loading.style.display = 'none';
      empty.querySelector('p').textContent = 'Fehler beim Laden.';
      empty.style.display = 'block';
    });
}

function renderMembers(members) {
  var grid = document.getElementById('members-grid');
  var empty = document.getElementById('members-empty');
  grid.innerHTML = '';
  if (!members || members.length === 0) { empty.style.display = 'block'; return; }
  empty.style.display = 'none';

  members.forEach(function(m) {
    var card = document.createElement('div');
    card.className = 'member-card';
    card.setAttribute('data-userid', m.id);
    card.setAttribute('data-search', (m.tag + ' ' + m.displayName).toLowerCase());
    card.onclick = function() { showMemberDetail(m.id); };

    var avatarHtml = m.avatar
      ? '<img src="' + m.avatar + '?size=80" alt="' + m.tag + '">'
      : '<div class="member-avatar-placeholder">' + (m.username.charAt(0).toUpperCase()) + '</div>';

    var warnBadge = m.warnCount > 0 ? '<span class="member-warn-badge">' + m.warnCount + '</span>' : '';

    card.innerHTML = '<div class="member-card-avatar">' + avatarHtml + warnBadge + '</div>' +
      '<div class="member-card-info"><span class="member-card-name">' + escapeHtml(m.displayName) + '</span>' +
      '<span class="member-card-tag">' + escapeHtml(m.tag) + '</span></div>';
    grid.appendChild(card);
  });
}

function filterMembers() {
  var query = (document.getElementById('member-search').value || '').toLowerCase();
  if (!query) { renderMembers(allMembers); return; }
  var filtered = allMembers.filter(function(m) {
    return (m.tag + ' ' + m.displayName).toLowerCase().indexOf(query) !== -1;
  });
  renderMembers(filtered);
}

function showMemberDetail(userId) {
  selectedMemberId = userId;
  var detailSide = document.getElementById('member-detail-side');
  detailSide.querySelector('.member-detail-placeholder').style.display = 'none';
  document.getElementById('member-detail-content').style.display = 'block';
  document.getElementById('member-detail-name').textContent = 'Lade...';

  fetch('/api/guild/' + guildId + '/members/' + userId)
    .then(function(r) { return r.json(); })
    .then(function(m) {
      if (m.error) { alert('Fehler: ' + m.error); closeMemberDetail(); return; }
      renderMemberDetail(m);
    })
    .catch(function() { alert('Fehler beim Laden.'); closeMemberDetail(); });
}

function renderMemberDetail(m) {
  document.getElementById('member-detail-name').textContent = m.displayName;
  document.getElementById('member-detail-tag').textContent = m.tag;
  document.getElementById('member-detail-id-text').textContent = m.id;
  document.getElementById('member-stat-warns').textContent = m.warnCount;
  document.getElementById('member-stat-notes').textContent = m.notes ? m.notes.length : 0;
  document.getElementById('member-stat-joined').textContent = m.joinedAt ? new Date(m.joinedAt).toLocaleDateString('de-DE') : '-';
  document.getElementById('member-stat-created').textContent = new Date(m.createdAt).toLocaleDateString('de-DE');

  var avatarEl = document.getElementById('member-detail-avatar');
  if (m.avatar) { avatarEl.src = m.avatar + '?size=128'; avatarEl.style.display = ''; }
  else { avatarEl.style.display = 'none'; }

  var timeoutRow = document.getElementById('member-stat-timeout-row');
  var timeoutBtn = document.getElementById('member-timeout-btn');
  if (m.communicationDisabledUntil) {
    timeoutRow.style.display = '';
    document.getElementById('member-stat-timeout').textContent = new Date(m.communicationDisabledUntil).toLocaleString('de-DE');
    if (timeoutBtn) { timeoutBtn.textContent = '✅ Timeout aufheben'; timeoutBtn.className = 'btn btn-sm btn-save'; timeoutBtn.onclick = removeTimeout; }
  } else {
    timeoutRow.style.display = 'none';
    if (timeoutBtn) { timeoutBtn.textContent = '⏱️ Timeout'; timeoutBtn.className = 'btn btn-sm btn-pink btn-timeout-btn'; timeoutBtn.onclick = openTimeoutModal; }
  }

  var rolesContainer = document.getElementById('member-roles-tags');
  rolesContainer.innerHTML = '';
  if (m.roles && m.roles.length > 0) {
    m.roles.forEach(function(r) {
      var span = document.createElement('span');
      span.className = 'member-role-tag';
      span.style.backgroundColor = hexToRgba(r.color, 0.2);
      span.style.color = r.color;
      span.style.borderColor = hexToRgba(r.color, 0.4);
      span.textContent = r.name;
      rolesContainer.appendChild(span);
    });
  } else { rolesContainer.innerHTML = '<span style="color:var(--text-secondary);text-align:center;padding:16px;font-size:13px;display:block">Keine Rollen</span>'; }

  // Notes
  var notesList = document.getElementById('member-notes-list');
  if (m.notes && m.notes.length > 0) {
    var html = '<div class="mini-table">';
    m.notes.forEach(function(n) {
      noteDataMap[n.id] = n.note;
      var updatedInfo = n.updated_at_formatted ? ' (bearbeitet: ' + n.updated_at_formatted + ')' : '';
      html += '<div class="mini-table-row note-row">' +
        '<div class="note-content"><span class="note-text">' + escapeHtml(n.note) + '</span>' +
        '<span class="mini-table-meta">von ' + escapeHtml(n.moderator_tag || n.moderator_id) + ' · ' + n.created_at_formatted + updatedInfo + '</span></div>' +
        '<div class="note-actions">' +
        '<button class="btn btn-sm btn-secondary" onclick="editNote(' + n.id + ')" title="Bearbeiten">✏️</button>' +
        '<button class="btn btn-sm btn-danger" onclick="deleteNote(' + n.id + ')" title="Löschen">🗑️</button></div></div>';
    });
    html += '</div>';
    notesList.innerHTML = html;
  } else { notesList.innerHTML = '<p style="color:var(--text-secondary);text-align:center;padding:16px;font-size:13px">Keine Notizen.</p>'; }

  // Warns
  var warnsList = document.getElementById('member-warns-list');
  if (m.warns && m.warns.length > 0) {
    var hw = '<div class="mini-table">';
    m.warns.forEach(function(w) {
      hw += '<div class="mini-table-row note-row">' +
        '<div class="note-content"><span class="note-text">#' + w.id + ' – ' + (w.reason ? escapeHtml(w.reason) : 'Kein Grund') + '</span>' +
        '<span class="mini-table-meta">von ' + escapeHtml(w.moderator_tag || w.moderator_id) + ' · ' + w.created_at_formatted + '</span></div>' +
        '<div class="note-actions"><button class="btn btn-sm btn-danger" onclick="removeWarn(' + w.id + ')" title="Verwarnung löschen">🗑️</button></div></div>';
    });
    hw += '</div>';
    warnsList.innerHTML = hw;
  } else { warnsList.innerHTML = '<p style="color:var(--text-secondary);text-align:center;padding:16px;font-size:13px">Keine Verwarnungen.</p>'; }

  // Mod logs
  var modlogsList = document.getElementById('member-modlogs-list');
  if (m.modLogs && m.modLogs.length > 0) {
    var hm = '<div class="mini-table">';
    m.modLogs.forEach(function(log) {
      hm += '<div class="mini-table-row">' +
        '<span class="badge badge-' + log.action.toLowerCase() + '"><span class="badge-dot"></span>' + log.action + '</span>' +
        '<span class="mini-table-reason">' + (log.reason ? escapeHtml(log.reason) : '-') + '</span>' +
        '<span class="mini-table-meta">' + log.created_at_formatted + '</span></div>';
    });
    hm += '</div>';
    modlogsList.innerHTML = hm;
  } else { modlogsList.innerHTML = '<p style="color:var(--text-secondary);text-align:center;padding:16px;font-size:13px">Keine Mod-Logs.</p>'; }
}

function closeMemberDetail() {
  selectedMemberId = null;
  var detailSide = document.getElementById('member-detail-side');
  detailSide.querySelector('.member-detail-placeholder').style.display = '';
  document.getElementById('member-detail-content').style.display = 'none';
  // Reset timeout btn
  var timeoutBtn = document.getElementById('member-timeout-btn');
  if (timeoutBtn) { timeoutBtn.textContent = '⏱️ Timeout'; timeoutBtn.className = 'btn btn-sm btn-pink btn-timeout-btn'; timeoutBtn.onclick = openTimeoutModal; }
}

function removeTimeout() {
  if (!selectedMemberId) return;
  if (!confirm('Timeout wirklich aufheben?')) return;
  var btn = document.getElementById('member-timeout-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Hebe auf...'; }
  fetch('/api/guild/' + guildId + '/members/' + selectedMemberId + '/untimeout', { method: 'POST' })
    .then(function(r) { return r.json(); })
    .then(function(data) {
      if (data.success) showMemberDetail(selectedMemberId);
      else alert('Fehler: ' + (data.error || 'Unbekannt'));
    })
    .catch(function() { alert('Fehler beim Aufheben.'); })
    .finally(function() { if (btn) { btn.disabled = false; btn.textContent = '✅ Timeout aufheben'; } });
}

// ══════════════════════════════════════════════
// Warn Modal
// ══════════════════════════════════════════════
function openWarnModal() {
  if (!selectedMemberId) return;
  var userName = document.getElementById('member-detail-name').textContent;
  var warnCount = parseInt(document.getElementById('member-stat-warns').textContent, 10) || 0;
  document.getElementById('warn-modal-user').textContent = userName;
  document.getElementById('warn-reason').value = '';
  var nextWarn = warnCount + 1;
  var cycleIdx = (nextWarn - 1) % 4;
  var text = cycleIdx < 3
    ? 'Nach dieser Verwarnung bekommt der Nutzer die Rolle <strong>' + (cycleIdx + 1) + '-Warn</strong>.'
    : '🚨 <strong>Achtung:</strong> Dies ist die 4. Verwarnung! Der Nutzer wird für <strong>2 Wochen getimeoutet</strong>.';
  document.getElementById('warn-consequence-text').innerHTML = text;
  document.getElementById('warn-modal-overlay').style.display = 'flex';
  document.getElementById('warn-submit-btn').disabled = false;
}

function closeWarnModal() { document.getElementById('warn-modal-overlay').style.display = 'none'; }

function submitWarn() {
  if (!selectedMemberId) return;
  var reason = (document.getElementById('warn-reason').value || '').trim();
  var btn = document.getElementById('warn-submit-btn');
  btn.disabled = true; btn.textContent = 'Wird verwarnt...';
  fetch('/api/guild/' + guildId + '/members/' + selectedMemberId + '/warn', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ reason: reason })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) { closeWarnModal(); showMemberDetail(selectedMemberId); loadMembers(); }
    else alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
  }).catch(function() { alert('Fehler beim Verwarnen.'); })
  .finally(function() { btn.disabled = false; btn.textContent = 'Verwarnen'; });
}

// ══════════════════════════════════════════════
// Timeout Modal
// ══════════════════════════════════════════════
var selectedTimeoutMinutes = null;

function selectTimeoutPreset(minutes, label) {
  selectedTimeoutMinutes = minutes;
  document.getElementById('timeout-duration').value = minutes;
  document.getElementById('selected-timeout').style.display = 'flex';
  document.getElementById('selected-timeout-text').textContent = label;
  document.querySelectorAll('.timeout-preset').forEach(function(b) {
    b.classList.toggle('active', b.getAttribute('data-minutes') == String(minutes));
  });
}

function openTimeoutModal() {
  if (!selectedMemberId) return;
  document.getElementById('timeout-modal-user').textContent = document.getElementById('member-detail-name').textContent;
  document.getElementById('timeout-reason').value = '';
  selectedTimeoutMinutes = null;
  document.getElementById('timeout-duration').value = '';
  document.getElementById('selected-timeout').style.display = 'none';
  document.querySelectorAll('.timeout-preset').forEach(function(b) { b.classList.remove('active'); });
  document.getElementById('timeout-modal-overlay').style.display = 'flex';
  document.getElementById('timeout-submit-btn').disabled = false;
}

function closeTimeoutModal() { document.getElementById('timeout-modal-overlay').style.display = 'none'; }

function submitTimeout() {
  if (!selectedMemberId) return;
  var durationMin = parseInt(document.getElementById('timeout-duration').value, 10);
  if (!durationMin || durationMin <= 0) { alert('Bitte wähle eine Dauer aus.'); return; }
  var reason = (document.getElementById('timeout-reason').value || '').trim();
  var btn = document.getElementById('timeout-submit-btn');
  btn.disabled = true; btn.textContent = 'Wird getimeoutet...';
  fetch('/api/guild/' + guildId + '/members/' + selectedMemberId + '/timeout', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ duration: durationMin * 60 * 1000, reason: reason })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) { closeTimeoutModal(); showMemberDetail(selectedMemberId); loadMembers(); }
    else alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
  }).catch(function() { alert('Fehler beim Timeout.'); })
  .finally(function() { btn.disabled = false; btn.textContent = 'Timeout verhängen'; });
}

// ══════════════════════════════════════════════
// Note Modal
// ══════════════════════════════════════════════
var editingNoteId = null;

function openNoteModal(noteId) {
  if (!selectedMemberId) return;
  document.getElementById('note-modal-user').textContent = document.getElementById('member-detail-name').textContent;
  editingNoteId = noteId || null;
  if (editingNoteId && noteDataMap[editingNoteId]) {
    document.getElementById('note-text').value = noteDataMap[editingNoteId];
    document.querySelector('#note-modal-overlay .modal-header h2').textContent = '📝 Notiz bearbeiten';
    document.getElementById('note-submit-btn').textContent = 'Notiz aktualisieren';
  } else {
    document.getElementById('note-text').value = '';
    document.querySelector('#note-modal-overlay .modal-header h2').textContent = '📝 Notiz hinzufügen';
    document.getElementById('note-submit-btn').textContent = 'Notiz speichern';
  }
  document.getElementById('note-modal-overlay').style.display = 'flex';
  document.getElementById('note-submit-btn').disabled = false;
}

function editNote(noteId) { openNoteModal(noteId); }

function closeNoteModal() { document.getElementById('note-modal-overlay').style.display = 'none'; editingNoteId = null; }

function submitNote() {
  if (!selectedMemberId) return;
  var noteText = (document.getElementById('note-text').value || '').trim();
  if (!noteText) { alert('Bitte gib einen Notiztext ein.'); return; }
  var btn = document.getElementById('note-submit-btn');
  btn.disabled = true;

  var url = editingNoteId
    ? '/api/guild/' + guildId + '/members/' + selectedMemberId + '/notes/' + editingNoteId
    : '/api/guild/' + guildId + '/members/' + selectedMemberId + '/notes';

  fetch(url, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ note: noteText })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) { closeNoteModal(); showMemberDetail(selectedMemberId); }
    else alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
  }).catch(function() { alert('Fehler beim Speichern.'); })
  .finally(function() { btn.disabled = false; });
}

function deleteNote(noteId) {
  if (!selectedMemberId) return;
  if (!confirm('Diese Notiz wirklich löschen?')) return;
  fetch('/api/guild/' + guildId + '/members/' + selectedMemberId + '/notes/' + noteId, { method: 'DELETE' })
    .then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) showMemberDetail(selectedMemberId);
      else alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
    });
}

function removeWarn(warnId) {
  if (!selectedMemberId) return;
  if (!confirm('Diese Verwarnung wirklich löschen?')) return;
  fetch('/api/guild/' + guildId + '/members/' + selectedMemberId + '/warns/' + warnId, { method: 'DELETE' })
    .then(function(r) { return r.json(); }).then(function(data) {
      if (data.success) showMemberDetail(selectedMemberId);
      else alert('Fehler: ' + (data.error || 'Unbekannter Fehler'));
    });
}

// ══════════════════════════════════════════════
// Ticket Functions
// ══════════════════════════════════════════════
function updateTicketOptionInputs() {
  var count = parseInt(document.getElementById('ticket-option-count').value, 10) || 1;
  if (count < 1) count = 1; if (count > 5) count = 5;
  document.getElementById('ticket-option-count').value = count;
  var container = document.getElementById('ticket-options-container');
  var currentInputs = container.querySelectorAll('.ticket-option-input');
  var values = [];
  currentInputs.forEach(function(inp) { values.push(inp.value); });
  container.innerHTML = '';
  for (var i = 0; i < count; i++) {
    var val = values[i] || ('Option ' + (i + 1));
    var div = document.createElement('div');
    div.innerHTML = '<input type="text" class="inp ticket-option-input" placeholder="Option ' + (i + 1) + '" value="' + escapeHtml(val) + '" style="min-width:200px">';
    container.appendChild(div);
  }
}

function loadTicketChannels() {
  fetch('/api/guild/' + guildId + '/tickets/channels')
    .then(function(r) { return r.json(); })
    .then(function(channels) {
      var sel = document.getElementById('ticket-channel-select');
      if (!sel) return;
      var html = '<option value="">-- Kanal wählen --</option>';
      channels.forEach(function(ch) { html += '<option value="' + ch.id + '">#' + escapeHtml(ch.name) + '</option>'; });
      sel.innerHTML = html;
      <% if (ticketPanel && ticketPanel.channel_id) { %>
        sel.value = '<%= ticketPanel.channel_id %>';
      <% } %>
    });
}

function loadSupportRolesList() {
  fetch('/api/guild/' + guildId + '/tickets/roles')
    .then(function(r) { return r.json(); })
    .then(function(roles) {
      var sel = document.getElementById('support-role-select');
      if (!sel) return;
      var html = '<option value="">-- Rolle wählen --</option>';
      roles.forEach(function(role) { html += '<option value="' + role.id + '">@' + escapeHtml(role.name) + '</option>'; });
      sel.innerHTML = html;
    });
}

function sendTicketPanel() {
  var channelId = document.getElementById('ticket-channel-select').value;
  if (!channelId) { alert('Bitte wähle einen Kanal aus.'); return; }
  var optionInputs = document.querySelectorAll('.ticket-option-input');
  var options = [];
  optionInputs.forEach(function(inp) {
    var label = inp.value.trim();
    if (label) options.push({ label: label, emoji: '🎫' });
  });
  if (options.length === 0) { alert('Bitte mindestens eine Option angeben.'); return; }
  var btn = document.getElementById('ticket-send-btn');
  if (btn) { btn.disabled = true; btn.textContent = 'Sende...'; }
  fetch('/api/guild/' + guildId + '/tickets/panel', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ channelId: channelId, options: options })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (data.success) alert('✅ Panel wurde gesendet!');
    else alert('❌ Fehler: ' + (data.error || 'Unbekannt'));
  }).catch(function(err) { alert('❌ Fehler: ' + err.message); })
  .finally(function() { if (btn) { btn.disabled = false; btn.textContent = '🚀 Panel senden'; } });
}

function appendSupportRoleTag(roleId) {
  var list = document.getElementById('support-roles-tags');
  if (!list) return;
  if (list.querySelector('[data-role="' + roleId + '"]')) return; // already listed
  var tag = document.createElement('span');
  tag.className = 'tag';
  tag.setAttribute('data-role', roleId);
  tag.innerHTML = '<@&' + roleId + '> <span class="tg-x" onclick="removeSupportRole(\'' + roleId + '\')">&times;</span>';
  list.appendChild(tag);
}

// No location.reload() here on purpose – a reload throws the user out of the
// Tickets tab and back to the overview. Update the list in place instead.
function addSupportRole() {
  var sel = document.getElementById('support-role-select');
  if (!sel) return;
  var roleId = sel.value;
  if (!roleId) { alert('Bitte wähle eine Rolle aus.'); return; }
  fetch('/api/guild/' + guildId + '/tickets/support-role/add', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ roleId: roleId })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (!data.success) { alert('❌ Fehler: ' + (data.error || 'Unbekannt')); return; }
    appendSupportRoleTag(roleId);
    sel.value = '';
  }).catch(function(err) { alert('❌ Fehler: ' + err.message); });
}

function removeSupportRole(roleId) {
  if (!confirm('Supporter-Rolle entfernen?')) return;
  fetch('/api/guild/' + guildId + '/tickets/support-role/remove', {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ roleId: roleId })
  }).then(function(r) { return r.json(); }).then(function(data) {
    if (!data.success) { alert('❌ Fehler: ' + (data.error || 'Unbekannt')); return; }
    var tag = document.querySelector('#support-roles-tags [data-role="' + roleId + '"]');
    if (tag) tag.remove();
  }).catch(function(err) { alert('❌ Fehler: ' + err.message); });
}

