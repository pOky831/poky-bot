// ════════════════ TAB: Mod-Logs ════════════════
function getModLogsTab() {
  var html = '<div class="card"><div class="card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/><line x1="8" y1="10" x2="16" y2="10"/><line x1="8" y1="14" x2="16" y2="14"/><line x1="8" y1="18" x2="12" y2="18"/></svg>Moderations-Logs (letzte 50)</div>';
  <% if (modLogs.length === 0) { %>
    html += '<div class="empty">Keine Moderations-Logs vorhanden.</div>';
  <% } else { %>
    html += '<div class="tw"><table><thead><tr><th>Aktion</th><th>Ziel</th><th>Moderator</th><th>Grund</th><th>Zeit</th></tr></thead><tbody>';
    <% modLogs.forEach(function(log) { %>
      var actionClass = '';
      var actionLower = '<%= log.action %>'.toLowerCase();
      if (actionLower === 'warn') actionClass = 'badge-warn';
      else if (actionLower === 'kick') actionClass = 'badge-kick';
      else if (actionLower === 'ban') actionClass = 'badge-ban';
      else if (actionLower === 'timeout') actionClass = 'badge-timeout';
      html += '<tr>' +
        '<td><span class="badge ' + actionClass + '"><span class="badge-dot"></span><%= log.action %></span></td>' +
        '<td><%= log.target_tag || log.target_id %></td>' +
        '<td><%= log.moderator_tag || log.moderator_id %></td>' +
        '<td><%= log.reason || "-" %></td>' +
        '<td><%= log.created_at_formatted %></td>' +
      '</tr>';
    <% }); %>
    html += '</tbody></table></div>';
  <% } %>
  html += '</div>';
  return html;
}

