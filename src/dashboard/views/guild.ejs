  <% if (giveaways.length === 0) { %>
    html += '<div class="empty">Keine Giveaways vorhanden. Nutze <code>/giveaway start</code> um eins zu erstellen.</div>';
  <% } else { %>
    html += '<div class="tw"><table><thead><tr><th>Preis</th><th>Status</th><th>Gewinner</th><th>Teilnehmer</th><th>Endet</th><th>Erstellt</th></tr></thead><tbody>';
    <% giveaways.forEach(function(gw) { %>
      html += '<tr>' +
        '<td><strong><%= gw.prize %></strong></td>' +
        '<td><% if (gw.status === "active") { %><span class="badge badge-active-gw"><span class="badge-dot"></span>Aktiv</span><% } else { %><span class="badge badge-ended"><span class="badge-dot"></span>Beendet</span><% } %></td>' +
        '<td><%= gw.winner_count %></td>' +
        '<td><%= gw.entryCount %></td>' +
